# libpq connection string for PostgreSQL (needs the pgvector + pgcrypto extensions)
KRONOS_DATABASE_URL=dbname=kronos
# Local LLM (Ollama). No case data leaves the machine.
KRONOS_OLLAMA_URL=http://localhost:11434
KRONOS_LLM_MODEL=llama3.1:8b
KRONOS_EMBED_MODEL=nomic-embed-text
# Fine-tuned model (QLoRA adapter served locally by scripts/finetune/serve.sh on 127.0.0.1:8081).
# ollama = base model only · openai = always the fine-tuned server · auto = fine-tuned when its server is running
KRONOS_LLM_BACKEND=ollama
KRONOS_LLM_URL=http://127.0.0.1:8081/v1
# Detector thresholds (all optional)
KRONOS_FIN_USE_IFOREST=true
KRONOS_FIN_USE_IQR=true
KRONOS_FIN_IQR_K=3.0
KRONOS_FIN_STRUCT_THRESHOLD=50000
KRONOS_TRAVEL_MAX_GROUND_KMH=150
KRONOS_TRAVEL_MAX_AIR_KMH=950
KRONOS_IDENTITY_HIGH=0.75
KRONOS_IDENTITY_MEDIUM=0.55
